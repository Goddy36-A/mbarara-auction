# Copy this file to .env and fill in real values. Never commit the real .env file.

DJANGO_SETTINGS_MODULE=config.settings.development

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_URL=postgres://auction_user:auction_pass@localhost:5432/mbarara_auction

CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Email — console backend is used in development so these are optional locally
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Redis / Celery (auction lifecycle tasks + async notifications)
# Install Redis locally: sudo apt install redis  OR  use docker-compose
REDIS_URL=redis://localhost:6379/0
